# Copier vers .env sur le VPS / Coolify — NE PAS committer de secrets réels.

SECRET_KEY=change-me-long-random
DEBUG=False
ALLOWED_HOSTS=merveille.raaga-bf.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://merveille.raaga-bf.com
CORS_ALLOW_ALL_ORIGINS=True

# Postgres dédié (supabase-db Contabo) — JAMAIS voltify / sooma / syras
DATABASE_URL=postgresql://merveille_app:CHANGE_ME@supabase-db:5432/merveille

# true une seule fois au premier boot, puis repasser à false
RUN_SEED=true

PORT=8000
WEB_WORKERS=2
